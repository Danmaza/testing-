# Backend Environment Variables

# Database Configuration
# TODO: REQUIRED INFO HERE (fill this in): your AWS RDS endpoint (e.g., mydb.123456.us-east-1.rds.amazonaws.com)
DB_HOST=

# TODO: REQUIRED INFO HERE (fill this in): your RDS username (e.g., admin)
DB_USER=

# TODO: REQUIRED INFO HERE (fill this in): your RDS password
DB_PASSWORD=

# TODO: REQUIRED INFO HERE (fill this in): your database/schema name (e.g., aok_transmissions)
DB_NAME=

# TODO: REQUIRED INFO HERE (fill this in): database port (typically 3306 for MySQL)
DB_PORT=3306

# Server Configuration
# TODO: REQUIRED INFO HERE (fill this in): port number for backend server (e.g., 3000)
PORT=3000

# JWT Configuration
# TODO: REQUIRED INFO HERE (fill this in): random secret string for JWT token signing (e.g., use: openssl rand -base64 32)
JWT_SECRET=

# TODO: REQUIRED INFO HERE (fill this in): JWT token expiration time (e.g., 24h, 7d)
JWT_EXPIRES_IN=24h

# CORS Configuration
# TODO: REQUIRED INFO HERE (fill this in): allowed frontend origin for CORS (e.g., http://localhost:5173)
CORS_ORIGIN=http://localhost:5173
